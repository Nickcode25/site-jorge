# Copie este arquivo para .env.local e preencha com os dados do seu projeto.
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anon-publica

# Opcional: chave secreta do Google Geocoding para enriquecer a busca por CEP.
# Sem essa chave, o cadastro continua funcionando com a consulta postal do ViaCEP.
GOOGLE_MAPS_API_KEY=sua-chave-do-google-maps
